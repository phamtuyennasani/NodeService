{
  "name": "node-content-crm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12 || ^24 || >=26"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json && vite build && npm run build:widget",
    "build:widget": "esbuild widget/ai-writer.ts --bundle --format=iife --target=es2022 --loader:.css=text --minify --outfile=dist/widget/v1/ai-writer.js",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env dist/server/main.js",
    "dev": "tsx --env-file-if-exists=.env src/main.ts",
    "dev:watch": "nodemon --watch src --watch web --watch widget --watch migrations --watch vite.config.ts --watch tsconfig.json --watch tsconfig.server.json --ext ts,tsx,css,html,json --exec \"npm run build && npm start\"",
    "dev:web": "vite",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "admin": "tsx --env-file-if-exists=.env scripts/create-admin.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.11",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "antd": "^6.7.1",
    "dayjs": "^1.11.23",
    "decimal.js": "^10.6.0",
    "dompurify": "^3.4.18",
    "fastify": "^5.12.8",
    "ipaddr.js": "^2.5.0",
    "mongodb": "^7.9.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.0",
    "sanitize-html": "^2.18.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.3.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "esbuild": "^0.28.2",
    "nodemon": "^3.1.14",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
