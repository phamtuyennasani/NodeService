MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DATABASE=node_service
# Startup default: VND per USD. Manage the live value in CRM > Cai dat.
# Operational settings saved in MongoDB override these defaults without a restart.
USD_TO_VND=25000
# Set production on the deployed service. Local development can omit this.
# NODE_ENV=production
# Generate once with openssl rand -base64 32. Share the value across processes.
ENCRYPTION_KEY=
APP_ORIGIN=http://localhost:3210
PORT=3210
HOST=127.0.0.1
# Connection tuning stays in env; worker tuning below supplies CRM defaults.
DB_POOL_SIZE=12
WORKER_POLL_MS=500
AI_TIMEOUT_MS=180000
# Optional planning and SEO repair idle timeouts. Each streamed chunk resets the timer.
# Outline defaults to AI_TIMEOUT_MS; SEO repair defaults to 90000 ms.
# AI_OUTLINE_TIMEOUT_MS=180000
# AI_SEO_REPAIR_TIMEOUT_MS=90000
LEASE_MS=210000
# Article research. DuckDuckGo works without a key. Tavily gives richer snippets.
RESEARCH_ENABLED=true
RESEARCH_PROVIDER=duckduckgo
RESEARCH_TIMEOUT_MS=8000
RESEARCH_MAX_RESULTS=5
# Set RESEARCH_PROVIDER=tavily and provide a Tavily API key to use Tavily search.
TAVILY_API_KEY=
# Optional custom Tavily-compatible endpoint.
# RESEARCH_ENDPOINT=https://api.tavily.com/search
# For local integrations with a Laravel webhook.
ALLOW_LOCAL_WEBHOOKS=false
# Optional for non-interactive `npm run admin -- <username>`.
# CRM_ADMIN_PASSWORD=
# Server-side AI keys for customers on a service plan.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
# OpenAI Compatible credentials are configured in CRM under Nhà cung cấp AI.
WORKER_CONCURRENCY=5
WEBHOOK_CONCURRENCY=5
# Fixed delay between retries for completed article delivery. Live value: CRM > Cai dat.
# One initial attempt plus at most three retries; integer minutes, 1-1440.
WEBHOOK_RETRY_MINUTES=5
# Provider limits. Set these to match the limits on the configured API accounts.
OPENAI_CONCURRENCY=10
OPENAI_REQUESTS_PER_MINUTE=60
OPENAI_TOKENS_PER_MINUTE=120000
ANTHROPIC_CONCURRENCY=10
ANTHROPIC_REQUESTS_PER_MINUTE=60
ANTHROPIC_TOKENS_PER_MINUTE=120000
XAI_CONCURRENCY=10
XAI_REQUESTS_PER_MINUTE=60
XAI_TOKENS_PER_MINUTE=120000
OPENAI_COMPATIBLE_CONCURRENCY=10
OPENAI_COMPATIBLE_REQUESTS_PER_MINUTE=60
OPENAI_COMPATIBLE_TOKENS_PER_MINUTE=120000
